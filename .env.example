# ── OpenMailSweep configuration ─────────────────────────────────────────────
# Copy to .env and edit. Nothing here should ever be committed.

# Provider: gmail | yahoo
#   gmail -> OAuth (run `openmailsweep auth` once, browser-based)
#   yahoo -> IMAP app password (create at mail.yahoo.com -> Settings ->
#            Accounts -> Manage app passwords; normal passwords are rejected)
MAIL_PROVIDER=gmail

# Yahoo credentials (required when MAIL_PROVIDER=yahoo)
# YAHOO_EMAIL=you@yahoo.com
# YAHOO_APP_PASSWORD=xxxx xxxx xxxx xxxx
# YAHOO_IMAP_HOST=imap.mail.yahoo.com
# YAHOO_SMTP_HOST=smtp.mail.yahoo.com

# ── Classifier ───────────────────────────────────────────────────────────────
# CLASSIFIER: local (default) — fast personalised model that runs fully on
# this machine. It learns from YOUR decisions; features are the email's own
# content (subject, body signals, structure, mailbox category) — never the
# exact sender address or List-ID (that is what learned rules are for).
# Optional: jev (hosted classifier) — requires JEV_API_KEY.
CLASSIFIER=local
# JEV_API_KEY=

# LOCAL_CLASSIFIER_DEVICE=auto            # auto | cpu | gpu (GPU only if a compatible one is present)
# LOCAL_CLASSIFIER_MIN_EXAMPLES=20        # below this: everything goes to Pending
# LOCAL_CLASSIFIER_AUTO_ACTION_MIN_EXAMPLES=100
# LOCAL_KEEP_THRESHOLD=0.70
# LOCAL_READ_LATER_THRESHOLD=0.75
# LOCAL_ARCHIVE_THRESHOLD=0.85
# LOCAL_CLEAN_THRESHOLD=0.95
# LOCAL_UNSUBSCRIBE_THRESHOLD=0.98
# LOCAL_CLASSIFIER_RETRAIN_INTERVAL=6h
# LOCAL_CLASSIFIER_RETRAIN_NEW_EXAMPLES=100
# LOCAL_CLASSIFIER_RETRAIN_ON_RULE_CHANGE=true
# LOCAL_CLASSIFIER_BOOTSTRAP_FROM_RULES=true
# LOCAL_CLASSIFIER_DIR=data/classifier

# ── Continuous intake ────────────────────────────────────────────────────────
OPENMAILSWEEP_SCAN_QUERY=in:inbox
OPENMAILSWEEP_FETCH_BATCH_SIZE=100        # provider page size only; no total cap
OPENMAILSWEEP_SCAN_INTERVAL=60
OPENMAILSWEEP_ACTION_POLL=1
OPENMAILSWEEP_ACTION_WORKERS=3
OPENMAILSWEEP_CLASSIFY_BATCH_SIZE=16

# ── Gmail API pacing (provider gmail) ───────────────────────────────────────
GMAIL_QUOTA_UNITS_PER_MINUTE=3600
GMAIL_QUOTA_BURST_UNITS=240
GMAIL_RATE_MAX_RETRIES=7
GMAIL_RATE_MAX_BACKOFF=64

# ── Paths / UI ───────────────────────────────────────────────────────────────
UI_PORT=8787
OAUTH_PORT=8765
# GMAIL_CREDENTIALS=secrets/credentials.json
# GMAIL_TOKEN=secrets/token.json
AUDIT_DB=data/audit.db
STATE_DB=data/openmailsweep.db
POLICY_FILE=policy.yaml

# ── Destructive CLI safety gates (audit/review/sweep/bulk-clean only) ─────
# The web UI and learned rules are always user-authorised.
ALLOW_SWEEP=false
ALLOW_UNSUBSCRIBE=false
